GEMINI_API_KEY=replace-with-your-key
GEMINI_MODEL=gemini-3.5-flash-lite
MAX_IMAGE_SIZE_MB=10
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# PostgreSQL local: valores de ejemplo; reemplazarlos manualmente en .env.
POSTGRES_DB=encuentrau
POSTGRES_USER=encuentrau
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://encuentrau:replace-with-a-local-password@127.0.0.1:5432/encuentrau
