GEMINI_API_KEY=replace-with-your-key
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=your_openai_api_key_here
AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_PROVIDER=gemini
MAX_IMAGE_SIZE_MB=10
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# PostgreSQL local: valores de ejemplo; reemplazarlos manualmente en .env.
POSTGRES_DB=encuentrau
POSTGRES_USER=encuentrau
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://encuentrau:replace-with-a-local-password@127.0.0.1:5432/encuentrau

# Generar una clave local con: python -c "import secrets; print(secrets.token_hex(32))"
# Vacía deshabilita login y validación JWT con un error controlado HTTP 503.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Private file storage; never expose this directory as static/public content.
REPORT_IMAGE_STORAGE_PROVIDER=local
REPORT_IMAGE_STORAGE_PATH=var/uploads
REPORT_IMAGE_MAX_BYTES=8388608

OPENAI_MODEL=gpt-5.4
OPENAI_REASONING_EFFORT=high
OPENAI_MAX_OUTPUT_TOKENS=8192
AI_TIMEOUT_SECONDS=60

# Private Redis for WebSocket chat notifications
REDIS_URL=redis://127.0.0.1:6379/0

# Production allowance units: photo=2, comparison=3; reset in America/Bogota.
# Enable only after applying migrations. Enabled accounting fails closed.
AI_QUOTA_ENABLED=true
AI_QUOTA_USER_HOUR=6
AI_QUOTA_USER_DAY=20
AI_QUOTA_GLOBAL_DAY=120
AI_QUOTA_GLOBAL_MONTH=1200
