# Store authoritative values in AWS Secrets Manager; materialize only on the host.
# chmod 600. Never commit the filled file. URL-encode the DB password.
DATABASE_URL=postgresql+psycopg://APP_USER:URL_ENCODED_PASSWORD@RDS_ENDPOINT:5432/encuentrau?sslmode=verify-full&sslrootcert=/certs/rds-ca.pem
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
OPENAI_API_KEY=REPLACE_ON_HOST
GEMINI_API_KEY=REPLACE_ON_HOST
AI_PRIMARY_PROVIDER=openai
OPENAI_MODEL=gpt-5.4
AI_FALLBACK_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=60
CORS_ORIGINS=https://app.example.com
